"""AST + virtual subprocess/cleanup only; no Popen, Git, network or model."""
import ast
import hashlib
import json
from pathlib import Path
import signal
import subprocess
import types
import unittest

SOURCE=Path(__file__).with_name('upstream_checkout01.py')
TREE=ast.parse(SOURCE.read_text(encoding='utf-8'))
def constant(name):
    node=next(n for n in TREE.body if isinstance(n,ast.Assign) and any(isinstance(t,ast.Name) and t.id==name for t in n.targets))
    return ast.literal_eval(node.value)
def extracted(tree,name,env):
    node=next(n for n in tree.body if isinstance(n,ast.FunctionDef) and n.name==name)
    exec(compile(ast.Module(body=[node],type_ignores=[]),str(SOURCE),'exec'),env)
    return env[name]
def require(ok,message):
    if not ok:raise ValueError(message)


class CleanupTests(unittest.TestCase):
    def run_case(self,pid=101,signal_error=None,reap_error=None,rc=0):
        calls=[]
        def kill(group,sig):
            calls.append((group,sig))
            if signal_error:raise signal_error('virtual error')
        def wait(timeout):
            if reap_error:raise reap_error
        p=types.SimpleNamespace(pid=pid,wait=wait,poll=lambda:rc)
        state={'attempted':False,'accepted':False,'events':[]}
        fn=extracted(TREE,'cleanup_once',{'os':types.SimpleNamespace(getpgrp=lambda:900,killpg=kill),'signal':signal,'subprocess':subprocess})
        fn(p,state)
        return fn,p,state,calls
    def test_success_once_no_historical_resignal(self):
        fn,p,s,c=self.run_case();self.assertTrue(s['accepted']);self.assertEqual(len(c),2)
        fn(p,s);self.assertEqual(len(c),2)
    def test_absent_group_accepted(self):
        _,_,s,c=self.run_case(signal_error=ProcessLookupError);self.assertTrue(s['accepted']);self.assertEqual(len(c),2)
    def test_permission_signal_error_rejects(self):
        fn,p,s,c=self.run_case(signal_error=PermissionError);self.assertFalse(s['accepted']);fn(p,s);self.assertEqual(len(c),2)
    def test_reap_timeout_rejects(self):
        _,_,s,_=self.run_case(reap_error=subprocess.TimeoutExpired('fake',5));self.assertFalse(s['accepted'])
    def test_reap_oserror_rejects(self):
        _,_,s,_=self.run_case(reap_error=OSError('fake'));self.assertFalse(s['accepted'])
    def test_controller_group_refused(self):
        _,_,s,c=self.run_case(pid=900);self.assertFalse(s['accepted']);self.assertEqual(c,[])
    def test_global_group_refused(self):
        _,_,s,c=self.run_case(pid=1);self.assertFalse(s['accepted']);self.assertEqual(c,[])
    def test_unreaped_leader_rejects(self):
        _,_,s,_=self.run_case(rc=None);self.assertFalse(s['accepted'])


class CommandTests(unittest.TestCase):
    def setup_run(self,rc=0,timeout=False):
        calls=[];writes=[]
        def run(command,**kw):
            calls.append((command,kw))
            if timeout:raise subprocess.TimeoutExpired(command,kw['timeout'])
            return types.SimpleNamespace(returncode=rc,stdout=b'git version fake\n',stderr=b'')
        class Sink:
            def __truediv__(self,name):return self
            def write_text(self,text):writes.append(text)
        clock=iter((1.,2.));rows=[]
        env={'require':require,'sha':lambda b:hashlib.sha256(b).hexdigest(),'deadline':90.,'rows':rows,'json':json,
             'STAGE':Sink(),'time':types.SimpleNamespace(monotonic=lambda:next(clock)),
             'subprocess':types.SimpleNamespace(run=run,PIPE=-1,TimeoutExpired=subprocess.TimeoutExpired)}
        fn=extracted(ast.parse(constant('CHILD')),'run',env)
        return fn,calls,writes,rows
    def test_real_command_shape_is_fixed_and_group_inherited(self):
        f,c,w,r=self.setup_run();self.assertEqual(f(['--version']),'git version fake')
        command,kw=c[0];self.assertEqual(command[:3],['git','-c','core.hooksPath=/dev/null'])
        self.assertIn('core.autocrlf=false',command);self.assertIn('credential.helper=',command)
        self.assertNotIn('start_new_session',kw);self.assertEqual(kw['timeout'],89.)
        self.assertEqual(r[0]['returncode'],0);self.assertEqual(r[0]['elapsed_seconds'],1.);self.assertEqual(len(w),1)
    def test_nonzero_preserved_and_rejected(self):
        f,c,w,r=self.setup_run(rc=128)
        with self.assertRaisesRegex(ValueError,'git command failed'):f(['--version'])
        self.assertEqual(r[0]['returncode'],128);self.assertEqual(len(w),1)
    def test_timeout_preserved_and_rejected(self):
        f,c,w,r=self.setup_run(timeout=True)
        with self.assertRaises(subprocess.TimeoutExpired):f(['--version'])
        self.assertTrue(r[0]['timed_out']);self.assertIsNone(r[0]['returncode']);self.assertEqual(len(w),1)


class StaticContracts(unittest.TestCase):
    def test_exact_pin_and_three_file_hashes_from_gate22(self):
        gate=json.loads(Path('artifacts/akt/preflight/gate2-evidence-20261108-linux-tooling-22.json').read_text())
        expected=next(n.value for n in TREE.body if isinstance(n,ast.Assign) and any(isinstance(t,ast.Name) and t.id=='EXPECTED' for t in n.targets))
        namespace={'PIN':constant('PIN'),'URL':constant('URL')}
        value=eval(compile(ast.Expression(expected),'<AST constants>','eval'),namespace)
        self.assertEqual(value,gate['source']);self.assertEqual(len(value['files']),3)
    def test_exact_kit_manifest_canonical_hash(self):
        m=json.loads(SOURCE.with_name('source-manifest.json').read_text())
        self.assertEqual(hashlib.sha256(json.dumps(m,sort_keys=True,separators=(',',':')).encode()).hexdigest(),constant('KIT_CANONICAL_SHA'))
        self.assertEqual(len(m['gate2_build_hashes']),120);self.assertEqual(len(m['files']),161)
    def test_exact_clone_fetch_sparse_command_contract(self):
        child=ast.parse(constant('CHILD'));calls=[n for n in child.body if isinstance(n,ast.Expr) and isinstance(n.value,ast.Call) and isinstance(n.value.func,ast.Name) and n.value.func.id=='run']
        text=[ast.unparse(n.value.args[0]) for n in calls]
        self.assertTrue(any("'clone', '--filter=blob:none', '--depth', '1', '--no-checkout', '--no-tags', URL" in v for v in text))
        self.assertTrue(any("'fetch', '--depth', '1', '--no-tags', '--filter=blob:none', 'origin', PIN" in v for v in text))
        self.assertTrue(any("'checkout', '--detach', PIN" in v for v in text))
        self.assertTrue(any("'set', '--no-cone', '/akt.py', '/README.md', '/LICENSE'" in v for v in text))
    def test_kit_verified_before_project_import(self):
        text=constant('CHILD');self.assertLess(text.index('kit_sha=verify_kit()'),text.index('from knowledge_tracing.akt.provenance import verify_upstream'))
        self.assertNotIn('import torch',text);self.assertNotIn('import numpy',text)
    def test_caps_and_exclusive_outputs(self):
        self.assertEqual(constant('CAP_SECONDS'),90)
        text=SOURCE.read_text();self.assertIn('CAP_BYTES=128*1024**2',text);self.assertIn('LOG_BYTES=4*1024**2',text)
        self.assertIn("STAGE.mkdir(exist_ok=False)",text)
        self.assertIn("'fresh upstream destination required'",text);self.assertNotIn('rmtree',text)
        self.assertIn('finally:cleanup_once(process,state)',text)


if __name__=='__main__':unittest.main(verbosity=2)
