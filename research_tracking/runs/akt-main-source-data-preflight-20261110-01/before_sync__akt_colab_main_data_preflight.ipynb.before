{
 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# AKT Main — kiểm nguồn và corpus trên Colab CPU\n",
    "\n",
    "Notebook kiểm khả năng nạp đúng source và hai corpus mô phỏng đã xuất bản trên môi trường đích. Chọn runtime CPU là đủ. Các bước chỉ tạo `.venv` trong thư mục mã dự án và dùng thư viện chuẩn Python. Không có bước cài thư viện, tạo model, huấn luyện hoặc gọi Modal.\n",
    "\n",
    "Gói cần tải lên là `akt-main-source-data-20261110-01.zip`. Kết quả xuất thành hồ sơ JSON nhỏ để lưu lại trong repository. Đây là kiểm dữ liệu, chưa nghiệm thu runtime Torch, Linux Git, CUDA, checkpoint hoặc quyền chạy thí nghiệm.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from pathlib import Path\n",
    "import hashlib, json, os, platform, subprocess, sys, time, venv, zipfile\n",
    "\n",
    "assert sys.platform.startswith('linux'), 'Notebook này dành cho Google Colab Linux'\n",
    "WORKSPACE = Path('/content/kltn_main_preflight')\n",
    "WORKSPACE.mkdir(exist_ok=True)\n",
    "ZIP_PATH = WORKSPACE / 'akt-main-source-data-20261110-01.zip'\n",
    "EXPECTED_SHA256 = '1eb5b613950cfc26d05f2790534ba42ece5c078ca95a9a5f91a0e6a1adbd0afc'\n",
    "if not ZIP_PATH.exists():\n",
    "    from google.colab import files\n",
    "    previous_cwd = Path.cwd()\n",
    "    try:\n",
    "        os.chdir(WORKSPACE)\n",
    "        uploaded = files.upload()\n",
    "        assert set(uploaded) == {ZIP_PATH.name}, 'Chỉ tải đúng một gói nguồn đã chỉ định'\n",
    "    finally:\n",
    "        os.chdir(previous_cwd)\n",
    "assert ZIP_PATH.stat().st_size <= 8 * 1024**2\n",
    "assert hashlib.sha256(ZIP_PATH.read_bytes()).hexdigest() == EXPECTED_SHA256\n",
    "print(json.dumps({'status': 'PACKAGE_VERIFIED', 'python': sys.version, 'platform': platform.platform(), 'bytes': ZIP_PATH.stat().st_size}, indent=2))\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "PROJECT = WORKSPACE / EXPECTED_SHA256[:16]\n",
    "PROJECT.mkdir(exist_ok=True)\n",
    "assert PROJECT.resolve() == PROJECT.absolute() and not PROJECT.is_symlink()\n",
    "with zipfile.ZipFile(ZIP_PATH) as archive:\n",
    "    names = archive.namelist()\n",
    "    assert len(names) == len(set(names)) <= 512\n",
    "    assert sum(member.file_size for member in archive.infolist()) <= 16 * 1024**2\n",
    "    manifest = json.loads(archive.read('MAIN_DATA_PACKAGE_MANIFEST.json'))\n",
    "    assert manifest['schema_version'] == 3 and manifest['neural_training_authorized'] is False\n",
    "    assert set(names) == set(manifest['files']) | {'MAIN_DATA_PACKAGE_MANIFEST.json'}\n",
    "    for member in archive.infolist():\n",
    "        name = member.filename\n",
    "        assert '\\\\' not in name and not Path(name).is_absolute() and '..' not in Path(name).parts\n",
    "        assert (member.external_attr >> 16) & 0o170000 != 0o120000\n",
    "        assert member.file_size <= 2 * 1024**2\n",
    "        target = PROJECT / name\n",
    "        cursor = PROJECT\n",
    "        for part in Path(name).parts:\n",
    "            cursor = cursor / part\n",
    "            assert not cursor.is_symlink()\n",
    "        assert target.resolve().is_relative_to(PROJECT.resolve())\n",
    "        raw = archive.read(member)\n",
    "        if name in manifest['files']:\n",
    "            assert hashlib.sha256(raw).hexdigest() == manifest['files'][name]\n",
    "        target.parent.mkdir(parents=True, exist_ok=True)\n",
    "        if target.exists():\n",
    "            assert target.read_bytes() == raw, 'Giữ nguyên nguồn cũ nếu có khác biệt, không ghi đè'\n",
    "        else:\n",
    "            with target.open('xb') as stream:\n",
    "                stream.write(raw)\n",
    "ENV = PROJECT / '.venv'\n",
    "assert not ENV.is_symlink()\n",
    "if not ENV.exists():\n",
    "    venv.EnvBuilder(with_pip=False, system_site_packages=False, symlinks=False).create(ENV)\n",
    "PYTHON = ENV / 'bin/python'\n",
    "assert PYTHON.is_file()\n",
    "check_env = subprocess.run([str(PYTHON), '-I', '-B', '-c', 'import sys,site,json;print(json.dumps({\"prefix\":sys.prefix,\"user_site\":site.ENABLE_USER_SITE}))'], capture_output=True, text=True, timeout=10, check=True)\n",
    "details = json.loads(check_env.stdout)\n",
    "assert Path(details['prefix']) == ENV and details['user_site'] is False\n",
    "print(json.dumps({'status': 'ISOLATED_STDLIB_VENV_READY', 'source_files': len(manifest['files']), 'project': str(PROJECT)}, indent=2))\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "PAYLOAD = \"\\nimport sys,json,hashlib\\nfrom pathlib import Path\\nstage=Path(sys.argv[1]);sys.path.insert(0,str(stage/'src'))\\ndef audit(event,args):\\n    if event=='import' and str(args[0]).split('.')[0] in {'torch','modal','boto3','pyBKT'}:raise RuntimeError('No model/runtime allocation in relocated data check')\\nsys.addaudithook(audit)\\nfrom knowledge_tracing import simulator_corpus_reader as reader\\nassert reader.ROOT==stage\\nmanifest=json.loads((stage/'MAIN_DATA_PACKAGE_MANIFEST.json').read_bytes());results={}\\nfor corpus_id,pins in manifest['corpora'].items():\\n    corpus=reader.read_public_research_corpus(corpus_id,expected_corpus_sha256=pins['corpus_sha256'],\\n        expected_done_sha256=pins['done_sha256'],limits=reader.CorpusReadLimits(2*1024**2,4*1024**2,256*1024,48,210,12600,20.))\\n    results[corpus_id]={role:{'learners':len(corpus.role_data(role).trajectories),'targets':corpus.role_data(role).audit['audit']['targets']} for role in ('train','selection','calibration')}\\nassert 'torch' not in sys.modules\\nprint(json.dumps({'accepted':True,'reader_origin':reader.__file__,'results':results,'scope':'Windows relocated reader only; no Linux/CUDA/runtime or training proof'}))\\n\"\n",
    "stamp = time.strftime('%Y%m%dT%H%M%SZ', time.gmtime())\n",
    "OUTPUT = PROJECT / ('data_preflight_' + stamp)\n",
    "OUTPUT.mkdir(exist_ok=False)\n",
    "started = time.monotonic()\n",
    "result = subprocess.run([str(PYTHON), '-I', '-B', '-c', PAYLOAD, str(PROJECT)], cwd=PROJECT, capture_output=True, text=True, timeout=30)\n",
    "(OUTPUT / 'stdout.log').write_text(result.stdout, encoding='utf-8')\n",
    "(OUTPUT / 'stderr.log').write_text(result.stderr, encoding='utf-8')\n",
    "receipt = {'returncode': result.returncode, 'elapsed_seconds': time.monotonic()-started, 'package_sha256': EXPECTED_SHA256, 'scope': 'Actual Linux public-data reader in isolated stdlib venv only', 'training_authorized': False, 'cuda_verified': False}\n",
    "if result.returncode == 0:\n",
    "    receipt['data'] = json.loads(result.stdout)\n",
    "(OUTPUT / 'receipt.json').write_text(json.dumps(receipt, ensure_ascii=False, indent=2), encoding='utf-8')\n",
    "assert result.returncode == 0, result.stderr[-3000:]\n",
    "assert receipt['data']['accepted'] is True\n",
    "print(json.dumps(receipt, ensure_ascii=False, indent=2))\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Lưu bằng chứng\n",
    "\n",
    "Cell cuối tải hồ sơ nhỏ của lượt kiểm vừa chạy. Giữ cả log lỗi nếu có. Dừng tại đây sau khi kiểm dữ liệu, các bước Torch/CUDA sẽ có allocation và nguồn kiểm riêng.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from google.colab import files\n",
    "import shutil\n",
    "EXPORT = Path(shutil.make_archive(str(OUTPUT), 'zip', root_dir=OUTPUT))\n",
    "assert EXPORT.stat().st_size <= 256 * 1024\n",
    "files.download(str(EXPORT))\n"
   ]
  }
 ],
 "metadata": {
